{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Signer Unseal",
  "version": "0.1.0",
  "identifier": "com.solitarybluga.signerunseal",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Signer Unseal",
